# Normalize line endings on checkin, check out with LF on Unix and CRLF on Windows.
* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.exe   binary
*.dll   binary
*.pdb   binary
*.ico   binary
*.apk   binary
*.orig  binary
*.dat   binary
*.resources binary
*.resx  text eol=lf
*.cs    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
